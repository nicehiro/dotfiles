shell-integration-features = ssh-terminfo,ssh-env,sudo,no-title

font-family = IoskeleyMono Nerd Font
font-size = 16
cursor-style = block
adjust-cell-height = 20%

foreground = #c0caf5
background = #24283b
cursor-color = #c0caf5
selection-foreground = #c0caf5
selection-background = #364a82
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

keybind = shift+enter=text:\n
background-opacity = 1
background-opacity-cells = true
background-blur = true
alpha-blending = native

window-padding-balance = true
window-padding-x = 20
window-padding-y = 10
window-save-state = always

macos-titlebar-style = tabs
