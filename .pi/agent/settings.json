{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "packages": [
    "https://github.com/default-anton/pi-librarian",
    "https://github.com/nicehiro/pi-relay",
    "https://github.com/davebcn87/pi-autoresearch.git",
    "npm:pi-subagents",
    "https://github.com/nicehiro/pi-arxiv",
    "npm:pi-web-access",
    "npm:pi-markdown-preview",
    "npm:@qraxiss/pi-gemini-auth"
  ],
  "theme": "system",
  "lastChangelogVersion": "1.6.1",
  "hideThinkingBlock": false,
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.2-astra",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "anthropic/claude-sonnet-5-5": "high"
  },
  "safeGit": {
    "enabledByDefault": true,
    "promptLevel": "medium"
  },
  "enableSkillCommands": true,
  "skills": [
    "~/.codex/skills"
  ],
  "enabledModels": [
    "openai/gpt-6.2-astra:high",
    "anthropic/claude-fable-5-2:medium",
    "anthropic/claude-opus-5-5:high",
    "anthropic/claude-sonnet-5-5:high",
    "openai/gpt-6.2-sol:high",
    "xai/grok-4.7:medium"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "anthropic/claude-fable-5-2",
        "thinking": "high"
      },
      "delegate": {
        "model": "openai/gpt-6.2-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "anthropic/claude-fable-5-2",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "anthropic/claude-fable-5-2",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "anthropic/claude-fable-5-2",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "anthropic/claude-fable-5-2",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "anthropic/claude-fable-5-2",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai/gpt-6.2-sol",
        "thinking": "high"
      }
    }
  },
  "tuiMode": "fullscreen",
  "extensionChangelogVersions": {
    "{\"source\":\"https://github.com/default-anton/pi-librarian\",\"scope\":\"user\"}": "1.3.7",
    "{\"source\":\"https://github.com/davebcn87/pi-autoresearch.git\",\"scope\":\"user\"}": "1.9.0",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.90.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@qraxiss/pi-gemini-auth\",\"scope\":\"user\"}": "0.5.1"
  }
}