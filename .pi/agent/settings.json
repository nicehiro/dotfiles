{
  "packages": [
    "https://github.com/default-anton/pi-librarian",
    "https://github.com/nicehiro/pi-relay",
    "https://github.com/davebcn87/pi-autoresearch.git",
    "npm:pi-subagents",
    "https://github.com/nicehiro/pi-arxiv",
    "npm:pi-web-access",
    "npm:pi-markdown-preview",
    "npm:@qraxiss/pi-gemini-auth"
  ],
  "theme": "system",
  "lastChangelogVersion": "0.99.1",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "anthropic/claude-sonnet-5-5": "high"
  },
  "safeGit": {
    "enabledByDefault": true,
    "promptLevel": "medium"
  },
  "enableSkillCommands": true,
  "skills": [
    "~/.codex/skills"
  ],
  "enabledModels": [
    "openai/gpt-6-astra:medium",
    "anthropic/claude-fable-5-1:medium",
    "anthropic/claude-opus-5-5:high",
    "anthropic/claude-sonnet-5-5:high",
    "openai/gpt-6.1-sol:high",
    "xai/grok-4.7:medium"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "anthropic/claude-fable-5-1",
        "thinking": "high"
      },
      "delegate": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "anthropic/claude-fable-5-1",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "anthropic/claude-fable-5-1",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "anthropic/claude-fable-5-1",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "anthropic/claude-fable-5-1",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "anthropic/claude-fable-5-1",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "high"
      }
    }
  },
  "tuiMode": "fullscreen"
}