{
  "packages": [
    "https://github.com/default-anton/pi-librarian",
    "https://github.com/nicehiro/pi-relay",
    "https://github.com/davebcn87/pi-autoresearch.git",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "https://github.com/nicehiro/pi-arxiv",
    "npm:pi-web-access"
  ],
  "theme": "zed-one-dark",
  "lastChangelogVersion": "0.80.3",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.5",
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "xhigh",
  "safeGit": {
    "enabledByDefault": true,
    "promptLevel": "medium"
  },
  "enableSkillCommands": true,
  "skills": [
    "~/.codex/skills"
  ],
  "enabledModels": [
    "openai/gpt-5.5:xhigh",
    "openai/gpt-5.5:high",
    "openai/gpt-5.5:off",
    "anthropic/claude-fable-5:xhigh",
    "anthropic/claude-fable-5:high"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "anthropic/claude-fable-5",
        "thinking": "high"
      },
      "delegate": {
        "model": "openai/gpt-5.5",
        "thinking": "medium"
      },
      "oracle": {
        "model": "anthropic/claude-fable-5",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "anthropic/claude-fable-5",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "anthropic/claude-fable-5",
        "thinking": "high"
      },
      "reviewer": {
        "model": "anthropic/claude-fable-5",
        "thinking": "high"
      },
      "scout": {
        "model": "openai/gpt-5.5",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai/gpt-5.5",
        "thinking": "medium"
      }
    }
  }
}
